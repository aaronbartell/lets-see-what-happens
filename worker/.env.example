# Anthropic — powers the build agent (use a separate key from the web app)
ANTHROPIC_API_KEY=

# Repo to build against, e.g. aaronbartell/lets-see-what-happens
GITHUB_REPO=

# GitHub auth — EITHER a GitHub App (recommended) OR a token for local dev
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_TOKEN=

# Knobs
AGENT_MODEL=claude-opus-5
MAX_COST_PER_ISSUE_USD=10
MAX_BUILDS_PER_DAY=10
POLL_INTERVAL_MS=60000

# Used in "shipped" comments to link the live feature
SITE_URL=
